# Cloudflare Pages _redirects — rules evaluated in order, first match wins.
#
# Note: /panel/* is handled in functions/_middleware.js (redirected 301 to
# ocs-super-panel.pages.dev) because static files in panel/ would otherwise
# take precedence over any _redirects rule here. The middleware runs first.

# Legacy /register.html now lives at the OCS8 affiliate signup. 302 so old
# bookmarks / search results land on the right place without permanently
# baking the third-party URL into search engines.
/register.html  https://ocs8my.com/signup?ref=OCSFMZ6HVI  302
/register       https://ocs8my.com/signup?ref=OCSFMZ6HVI  302

# Retired verticals (Aug 2026): ScoreOCS8 is football-only. Old dota2. /
# badminton. subdomain hosts are 301'd in functions/_middleware.js; these
# cover any in-repo paths that were linked internally or picked up by search.
/dota2/*      /   301
/badminton/*  /   301
/dota2-site/*      /   301
/badminton-site/*  /   301
